# Copie este arquivo para ou renomeie para .env e preencha os valores abaixo.
# Aplicação Telegram: https://my.telegram.org > API development tools
# API_ID deve conter somente números.
API_ID=
API_HASH=

# Token fornecido pelo @BotFather ao criar o bot com /newbot.
BOT_TOKEN=

# ID do chat que receberá os alertas (veja o passo a passo no README).
CHAT_ID=
